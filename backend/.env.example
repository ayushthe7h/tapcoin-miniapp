# --- Telegram ---
BOT_TOKEN=123456:ABC-your-telegram-bot-token
BOT_USERNAME=YourBot

# --- Database ---
# SQLite only. The file is created automatically on first launch — no setup needed.
DATABASE_URL=sqlite+aiosqlite:///./tapcoin.db

# --- JWT ---
JWT_SECRET=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# --- Admin ---
ADMIN_JWT_SECRET=change_this_too_a_different_long_random_string
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=change_me_immediately

# --- App ---
ENV=production
CORS_ORIGINS=https://yourdomain.com,https://t.me
INIT_DATA_MAX_AGE_SECONDS=86400
